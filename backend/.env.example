# Backend environment variables (copy to .env and fill in)
PORT=5000
# MongoDB connection URI (Atlas cluster or local MongoDB).
# Leave empty to fall back to an in-memory database for local development.
MONGODB_URI=mongodb://127.0.0.1:27017/student_task_manager
# Secret used to sign JWTs — use a long random string in production.
JWT_SECRET=your_super_secret_jwt_key_change_in_production
# Optional: set to "true" to always use the in-memory database.
# USE_MEMORY_DB=false